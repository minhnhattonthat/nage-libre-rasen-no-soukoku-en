[
 {
  "id": "MAP82/186/0030",
  "jp": "ここにナージュ像がまつられてたんだね",
  "en": ""
 },
 {
  "id": "MAP82/186/0062",
  "jp": "ナージュ像がこの穴を塞いでいたおかげで、",
  "en": ""
 },
 {
  "id": "MAP82/186/0092",
  "jp": "今まで魔物はこちらの世界に入ってこれなかったんですね。",
  "en": ""
 },
 {
  "id": "MAP82/186/00D6",
  "jp": "何か他のモンで塞いじゃえばイイんじゃないの～？",
  "en": ""
 },
 {
  "id": "MAP82/186/010C",
  "jp": "バケツとかでさ～",
  "en": ""
 },
 {
  "id": "MAP82/186/012A",
  "jp": "ん～・・・\nご利益なさそうだな",
  "en": ""
 },
 {
  "id": "MAP82/186/0154",
  "jp": "じゃぁハコはハコ？",
  "en": ""
 },
 {
  "id": "MAP82/186/0174",
  "jp": "箱のハナシはしてねーだろ。",
  "en": ""
 },
 {
  "id": "MAP82/186/019C",
  "jp": "ま、とにかく・・・",
  "en": ""
 },
 {
  "id": "MAP82/186/01BC",
  "jp": "この穴の向こうが異世界ってわけか。",
  "en": ""
 },
 {
  "id": "MAP82/186/01EC",
  "jp": "なんだか緊張してしまいますね。",
  "en": ""
 },
 {
  "id": "MAP82/186/0218",
  "jp": "ドキドキドキ。",
  "en": ""
 },
 {
  "id": "MAP82/186/0234",
  "jp": "覚悟はできてるぜ。",
  "en": ""
 },
 {
  "id": "MAP82/186/025A",
  "jp": "じゃー、みんな。　行くよ。",
  "en": ""
 },
 {
  "id": "MAP82/188/00AC",
  "jp": "ここは・・・\nドコなの？",
  "en": ""
 },
 {
  "id": "MAP82/188/00D0",
  "jp": "どうやら、\nあの世じゃないのは確かなようね。",
  "en": ""
 },
 {
  "id": "MAP82/188/010E",
  "jp": "・・・南寿、神社？",
  "en": ""
 },
 {
  "id": "MAP82/188/0134",
  "jp": "爆風のショックで\n戻って来たんですね",
  "en": ""
 },
 {
  "id": "MAP82/188/016A",
  "jp": "たっだいまーっ！",
  "en": ""
 },
 {
  "id": "MAP82/188/018E",
  "jp": "ただいまーって真！",
  "en": ""
 },
 {
  "id": "MAP82/188/01A8",
  "jp": "お前のせいでナージュ像、爆発しちまったじゃねーか！！",
  "en": ""
 },
 {
  "id": "MAP82/188/01F0",
  "jp": "良くも悪くも、結果オーライだよ！",
  "en": ""
 },
 {
  "id": "MAP82/188/021E",
  "jp": "良くねえぞ、真！",
  "en": ""
 },
 {
  "id": "MAP82/188/023C",
  "jp": "どうすんだよ？\nお前をナージュ像みたく金色に塗ってそこに置いとくぞ。",
  "en": ""
 },
 {
  "id": "MAP82/188/029E",
  "jp": "あれっ、司クン、\n迎えにきてくれたのね～！！",
  "en": ""
 },
 {
  "id": "MAP82/188/02DC",
  "jp": "うそ！",
  "en": ""
 },
 {
  "id": "MAP82/188/02EA",
  "jp": "・・・いや、",
  "en": ""
 },
 {
  "id": "MAP82/188/02FE",
  "jp": "コホン。",
  "en": ""
 },
 {
  "id": "MAP82/188/030E",
  "jp": "お待ちしていました皆さんよくご無事で",
  "en": ""
 },
 {
  "id": "MAP82/188/0340",
  "jp": "会長、謝らなきゃいけない事があるの。",
  "en": ""
 },
 {
  "id": "MAP82/188/036C",
  "jp": "異世界でナージュ像を壊しちゃったの。",
  "en": ""
 },
 {
  "id": "MAP82/188/039E",
  "jp": "あの、\nその件なんですが、",
  "en": ""
 },
 {
  "id": "MAP82/188/03C4",
  "jp": "なんて言ったらいいか・・・",
  "en": ""
 },
 {
  "id": "MAP82/188/03E6",
  "jp": "もう、この世に・・ナージュ像は存在しないんだ。",
  "en": ""
 },
 {
  "id": "MAP82/188/0422",
  "jp": "・・・爆発してしまったものですから。",
  "en": ""
 },
 {
  "id": "MAP82/188/044E",
  "jp": "すみません！",
  "en": ""
 },
 {
  "id": "MAP82/188/0468",
  "jp": "司クン、\nごめんね。",
  "en": ""
 },
 {
  "id": "MAP82/188/0488",
  "jp": "まあ、そういう事もある。",
  "en": ""
 },
 {
  "id": "MAP82/188/04AE",
  "jp": "実は美術部の連中がナージュ像を創ったっていうから・・・",
  "en": ""
 },
 {
  "id": "MAP82/188/04EC",
  "jp": "それを置いてみたら異世界からの穴もふさがるかな～なんて",
  "en": ""
 },
 {
  "id": "MAP82/188/052A",
  "jp": "これがその、ナージュ像なんですが・・",
  "en": ""
 },
 {
  "id": "MAP82/188/0556",
  "jp": "美術部のよし子さんよし夫さん、置いてみてください。",
  "en": ""
 },
 {
  "id": "MAP82/188/0598",
  "jp": "はい。",
  "en": ""
 },
 {
  "id": "MAP82/188/05A8",
  "jp": "わかりました。",
  "en": ""
 },
 {
  "id": "MAP82/188/05C4",
  "jp": "それはナージュ像！",
  "en": ""
 },
 {
  "id": "MAP82/188/05E4",
  "jp": "待っててくれたんじゃ、なかったの？",
  "en": ""
 },
 {
  "id": "MAP82/188/0614",
  "jp": "それじゃあ、俺たち危うく閉じ込められるところだったのか",
  "en": ""
 },
 {
  "id": "MAP82/188/0658",
  "jp": "何と申しましょうか皆さんが異世界に行ってることを、",
  "en": ""
 },
 {
  "id": "MAP82/188/0692",
  "jp": "すっかり\n忘れてました。",
  "en": ""
 },
 {
  "id": "MAP82/188/06B6",
  "jp": "そんな、ひどいっ！",
  "en": ""
 },
 {
  "id": "MAP82/188/06D6",
  "jp": "だいたいナージュの力があってこそ、　封印できるんじゃないの？",
  "en": ""
 },
 {
  "id": "MAP82/188/0720",
  "jp": "仏作って魂入れず。",
  "en": ""
 },
 {
  "id": "MAP82/188/0740",
  "jp": "まあ美術部の有志がせっかく造ってくれたんです。",
  "en": ""
 },
 {
  "id": "MAP82/188/0776",
  "jp": "とりあえず、試してみましょう。",
  "en": ""
 },
 {
  "id": "MAP82/188/07C0",
  "jp": "・・・あらら、\n閉まっちゃったよ。",
  "en": ""
 },
 {
  "id": "MAP82/188/07EE",
  "jp": "これでよしと。",
  "en": ""
 },
 {
  "id": "MAP82/188/080A",
  "jp": "ほんとに、\nこんなんでいいのか",
  "en": ""
 },
 {
  "id": "MAP82/188/0834",
  "jp": "最初からこうすればよかった、ってことですね。",
  "en": ""
 },
 {
  "id": "MAP82/188/0868",
  "jp": "あんな大変な思いまでしたのに。",
  "en": ""
 },
 {
  "id": "MAP82/188/0894",
  "jp": "ホント、言いえて妙ね。",
  "en": ""
 },
 {
  "id": "MAP82/188/08B2",
  "jp": "まあ、これで一件落着ってとこね。",
  "en": ""
 },
 {
  "id": "MAP82/188/08E0",
  "jp": "そんなことないよ！",
  "en": ""
 },
 {
  "id": "MAP82/188/0904",
  "jp": "・・・お前だけは、異世界に閉じ込めるべきだったな。",
  "en": ""
 },
 {
  "id": "MAP82/188/0944",
  "jp": "今からでも遅くない",
  "en": ""
 },
 {
  "id": "MAP82/188/0964",
  "jp": "やっと、明日から　平和な商店街に戻りますわ。",
  "en": ""
 },
 {
  "id": "MAP82/188/099E",
  "jp": "あんな危険なめにあって生きてるだけでも幸運だしな。",
  "en": ""
 },
 {
  "id": "MAP82/188/09DE",
  "jp": "私は、司クンにまた会えた事が一番うれしー！",
  "en": ""
 },
 {
  "id": "MAP82/188/0A16",
  "jp": "また言ってるよ。",
  "en": ""
 },
 {
  "id": "MAP82/188/0A34",
  "jp": "それじゃあ商店街のみんなに帰ってきた報告をしなきゃね。",
  "en": ""
 },
 {
  "id": "MAP82/188/0A78",
  "jp": "私は、家族のもとへ戻りますわ。",
  "en": ""
 },
 {
  "id": "MAP82/188/0AAA",
  "jp": "私は、司クンの側にずっといるー！",
  "en": ""
 },
 {
  "id": "MAP82/188/0ADE",
  "jp": "樹はほっといてみんな、いくよ！",
  "en": ""
 },
 {
  "id": "MAP82/188/0B10",
  "jp": "ああ。",
  "en": ""
 },
 {
  "id": "MAP82/188/0B2A",
  "jp": "・・・忍さん、\n大さんの事、気にしてるんじゃないですか？",
  "en": ""
 },
 {
  "id": "MAP82/188/0B74",
  "jp": "あいつ、あの爆発で今ごろ・・・",
  "en": ""
 },
 {
  "id": "MAP82/188/0BA6",
  "jp": "違う！澪こそ迅の心配してたんだろ！",
  "en": ""
 },
 {
  "id": "MAP82/188/0BDC",
  "jp": "はい・・・",
  "en": ""
 },
 {
  "id": "MAP82/188/0BF4",
  "jp": "かいちょー、\nところで商品券は？",
  "en": ""
 },
 {
  "id": "MAP82/188/0C26",
  "jp": "やめなよ、真。\n私たち何も役に立ってないんだよ。",
  "en": ""
 },
 {
  "id": "MAP82/188/0C5C",
  "jp": "そんなのもらう資格ないんだから。",
  "en": ""
 },
 {
  "id": "MAP82/188/0C90",
  "jp": "お前のせいだと何度言わせるんだ。\nあつかましーやつだな、真。",
  "en": ""
 },
 {
  "id": "MAP82/188/0CD8",
  "jp": "申し遅れました。\nその商品券なんですが・・・",
  "en": ""
 },
 {
  "id": "MAP82/188/0D16",
  "jp": "美術部のナージュ像制作資金に当てられてしまい、",
  "en": ""
 },
 {
  "id": "MAP82/188/0D4C",
  "jp": "変わりに皆さんには生徒会が用意した、",
  "en": ""
 },
 {
  "id": "MAP82/188/0D78",
  "jp": "南の島の旅行券が、特別に渡されます。",
  "en": ""
 },
 {
  "id": "MAP82/188/0DA4",
  "jp": "皆さんの活躍には、感謝します。",
  "en": ""
 },
 {
  "id": "MAP82/188/0DCA",
  "jp": "・・・あと南の島といっても、異世界の海ではなく、ハワイです。",
  "en": ""
 },
 {
  "id": "MAP82/188/0E14",
  "jp": "ホント？\n商品券より断然いいよ！",
  "en": ""
 },
 {
  "id": "MAP82/188/0E40",
  "jp": "私たちなんかにもったいないお言葉ー！",
  "en": ""
 },
 {
  "id": "MAP82/188/0E72",
  "jp": "わーい、ハワイだーカニ食べた～い！",
  "en": ""
 },
 {
  "id": "MAP82/188/0EA8",
  "jp": "良かったな真、\nハワイでザリガニでも食ったらどうだ？",
  "en": ""
 },
 {
  "id": "MAP82/188/0EEE",
  "jp": "うれしいですわ。",
  "en": ""
 },
 {
  "id": "MAP82/188/0F0C",
  "jp": "ありがとう、相田司生徒会長。",
  "en": ""
 },
 {
  "id": "MAP82/188/0F36",
  "jp": "いいえ、この程度のお礼しかできなくて・・・",
  "en": ""
 },
 {
  "id": "MAP82/188/0F68",
  "jp": "それでは、ハワイ旅行を存分に楽しんでください。",
  "en": ""
 },
 {
  "id": "MAP82/188/0F9E",
  "jp": "最後に・・・",
  "en": ""
 },
 {
  "id": "MAP82/188/0FB2",
  "jp": "また南寿町の危機が訪れた時皆さんに、お願いしてもよろしいですか？",
  "en": ""
 },
 {
  "id": "MAP82/188/1000",
  "jp": "いやです会長。",
  "en": ""
 },
 {
  "id": "MAP82/188/1036",
  "jp": "真！\nそのままだと進級できないぞ！",
  "en": ""
 }
]
