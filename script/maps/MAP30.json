[
 {
  "id": "MAP30/186/000A",
  "jp": "何でここだけ冬なのよー？",
  "en": ""
 },
 {
  "id": "MAP30/186/0030",
  "jp": "やっぱりこの世界に常識は通用しないんですね。",
  "en": ""
 },
 {
  "id": "MAP30/186/006A",
  "jp": "これがこの世界の常識なんだろ。",
  "en": ""
 },
 {
  "id": "MAP30/186/0096",
  "jp": "じょーしき　じょーしき。\n真がほーりつーっ！",
  "en": ""
 },
 {
  "id": "MAP30/186/00D4",
  "jp": "・・・お前は雪でも食ってろ。",
  "en": ""
 },
 {
  "id": "MAP30/186/00FE",
  "jp": "寒いのやだよー。",
  "en": ""
 },
 {
  "id": "MAP30/186/0122",
  "jp": "寒さが何よ、あんたいっつもおへそ出してるじゃん。",
  "en": ""
 },
 {
  "id": "MAP30/186/0166",
  "jp": "それとこれとは別なの。",
  "en": ""
 },
 {
  "id": "MAP30/186/0192",
  "jp": "城塞へは行かせないよっ！！",
  "en": ""
 },
 {
  "id": "MAP30/186/01B4",
  "jp": "アンタ達は、この氷の下で永遠に眠ってなっ！",
  "en": ""
 },
 {
  "id": "MAP30/186/020A",
  "jp": "ひょっとしてこいつら私たちが来るまでずっと雪の中にもぐってたの？",
  "en": ""
 },
 {
  "id": "MAP30/186/0258",
  "jp": "私たちが違うルートを通っていたらどうなっていたんでしょう。",
  "en": ""
 },
 {
  "id": "MAP30/186/02A0",
  "jp": "くちびる青いよ。",
  "en": ""
 },
 {
  "id": "MAP30/186/02BE",
  "jp": "うるさいうるさいっ敵の同情なんかいらないっ！\n勝負だっ！！",
  "en": ""
 },
 {
  "id": "MAP30/187/0002",
  "jp": "　７面スタート　",
  "en": ""
 },
 {
  "id": "MAP30/187/001C",
  "jp": "　クリアー条件　　\n  %c02　敵を全滅させろ　",
  "en": ""
 },
 {
  "id": "MAP30/188/0036",
  "jp": "どーしたぁっ！　　オレと勝負したい奴はいねーのか！？",
  "en": ""
 },
 {
  "id": "MAP30/188/007C",
  "jp": "もうみんな、いなくなっちゃったよ。",
  "en": ""
 },
 {
  "id": "MAP30/188/0112",
  "jp": "樹、どうしちゃったのよ「スノボやろー」とか言わないの？",
  "en": ""
 },
 {
  "id": "MAP30/188/0164",
  "jp": "私、ほんと寒いのダメなんだって。",
  "en": ""
 },
 {
  "id": "MAP30/188/01AA",
  "jp": "雪合戦やろーよ、雪合戦。",
  "en": ""
 },
 {
  "id": "MAP30/188/01DE",
  "jp": "一人でやっててよ。",
  "en": ""
 },
 {
  "id": "MAP30/188/020C",
  "jp": "一人じゃできなーい",
  "en": ""
 },
 {
  "id": "MAP30/188/023A",
  "jp": "ねぇ、真さん。\nナージュ像を見つけてからにしましょ。",
  "en": ""
 },
 {
  "id": "MAP30/188/0288",
  "jp": "うん、そーだね。　ナージュ像を見つけてからにするっ。",
  "en": ""
 },
 {
  "id": "MAP30/188/02D8",
  "jp": "澪って保母さんの才能あるんじゃない。",
  "en": ""
 },
 {
  "id": "MAP30/189/0016",
  "jp": "私もうダメ・・・　もう動けない。",
  "en": ""
 },
 {
  "id": "MAP30/189/0046",
  "jp": "超疲れた、今回はパス。",
  "en": ""
 },
 {
  "id": "MAP30/189/006C",
  "jp": "えーん、みんなが　いぢめるよー。",
  "en": ""
 },
 {
  "id": "MAP30/189/009C",
  "jp": "チッ、オレとしたことが・・・不覚。",
  "en": ""
 },
 {
  "id": "MAP30/189/00CE",
