[
 {
  "id": "MAP06/186/001C",
  "jp": "おーっほっほっほっあなた達ねナージュ像を狙っている悪い子というのは。",
  "en": ""
 },
 {
  "id": "MAP06/186/006E",
  "jp": "誰？　こいつ。　　何がおかしいの？",
  "en": ""
 },
 {
  "id": "MAP06/186/009E",
  "jp": "さあ・・・？",
  "en": ""
 },
 {
  "id": "MAP06/186/00B8",
  "jp": "この人、梅林学園の生徒会長、神崎　薫%h（かんざき　かおる）%zさんですわ。",
  "en": ""
 },
 {
  "id": "MAP06/186/010E",
  "jp": "じゃあこの人が・・",
  "en": ""
 },
 {
  "id": "MAP06/186/012E",
  "jp": "ナージュ像を盗んだ犯人！？",
  "en": ""
 },
 {
  "id": "MAP06/186/0156",
  "jp": "犯人だなんて人聞きの悪い。\n私は善を為しているのよ。",
  "en": ""
 },
 {
  "id": "MAP06/186/0190",
  "jp": "ナージュ像もあの土地も、真の価値を知る私たちのような高貴な者が使ってこそ",
  "en": ""
 },
 {
  "id": "MAP06/186/01E0",
  "jp": "意味があるのよ。",
  "en": ""
 },
 {
  "id": "MAP06/186/01FE",
  "jp": "そんな理屈っ・・・",
  "en": ""
 },
 {
  "id": "MAP06/186/021E",
  "jp": "ほっとこうよ・・・",
  "en": ""
 },
 {
  "id": "MAP06/186/023E",
  "jp": "やっちゃおっか？",
  "en": ""
 },
 {
  "id": "MAP06/186/0260",
  "jp": "まぁ、わざわざ私が出向くほどではなかったようね。\nさ、行くわよ。",
  "en": ""
 },
 {
  "id": "MAP06/186/02B0",
  "jp": "押忍",
