 },
 {
  "id": "MAP31/186/0282",
  "jp": "そうだ、そうだっ！",
  "en": ""
 },
 {
  "id": "MAP31/186/02A2",
  "jp": "動物はいぢめちゃぁいけないんだゾッ！",
  "en": ""
 },
 {
