[
 {
  "id": "MAP31/186/0034",
  "jp": "ここの温泉は俺達のもんだ、お前達は、出て行け！！",
  "en": ""
 },
 {
  "id": "MAP31/186/0076",
  "jp": "しっしっ\nもう二度と来ないで",
  "en": ""
 },
 {
  "id": "MAP31/186/00A2",
  "jp": "こびー　ここびー",
  "en": ""
 },
 {
  "id": "MAP31/186/00CC",
  "jp": "変な動物がいぢめられてるよ。",
  "en": ""
 },
 {
  "id": "MAP31/186/00F6",
  "jp": "面白そーっ！\n真もまぜてーっ！",
