 {
  "id": "MAP31/200/0016",
  "jp": "はぁ～～～・・・　気持ちいぃ～～～",
  "en": ""
 },
 {
  "id": "MAP31/200/0048",
  "jp": "このスベスベお肌で相田クンもメロメロね。",
  "en": ""
 },
 {
  "id": "MAP31/200/0080",
  "jp": "はぁー　気持ちい～　ちにゃっ。",
  "en": ""
 },
 {
  "id": "MAP31/200/00AE",
  "jp": "これなら身体の疲れも、いっきに吹き飛ぶゼ。",
  "en": ""
 },
 {
  "id": "MAP31/200/00E8",
  "jp": "身体も心も暖まりますね。",
  "en": ""
 },
 {
  "id": "MAP31/201/002E",
  "jp": "こびこびー。\nこびび、こびこびび",
  "en": ""
 },
 {
  "id": "MAP31/201/0054",
  "jp": "（ありがとう、ためになる話が聞けて、良かったヨ。）",
  "en": ""
 },
 {
  "id": "MAP31/201/00AA",
  "jp": "みんな準備はいい？",
  "en": ""
 },
 {
  "id": "MAP31/201/00D4",
  "jp": "ＯＫ！\n疲れもとれたしな。",
  "en": ""
 },
 {
  "id": "MAP31/201/0104",
  "jp": "この道を抜ければ、梅林学園のお城が　見えるって。",
  "en": ""
 },
 {
  "id": "MAP31/201/014C",
  "jp": "え～～\nもう行っちゃうの？",
  "en": ""
 },
 {
  "id": "MAP31/201/017C",
  "jp": "こびーろさんたちのためにも、",
  "en": ""
 },
 {
  "id": "MAP31/201/01A0",
  "jp": "一刻もはやくナージュ像を取り戻さないと。",
  "en": ""
 },
 {
  "id": "MAP31/201/01E0",
  "jp": "はいはい・・・　　わかりましたよ。",
  "en": ""
 },
 {
  "id": "MAP31/202/000E",
  "jp": "”ローファー”を手に入れた\n（着せかえ用アイテム）",
  "en": ""
 },
 {
  "id": "MAP31/203/0002",
  "jp": "この松の木は、樹齢１８０年。その時あなたは何歳？",
  "en": ""
 },
 {
  "id": "MAP31/203/0050",
  "jp": "前世占いで、勇者アディオスの息子１５歳とか言われたことがあったけど。",
  "en": ""
 },
 {
  "id": "MAP31/203/00A4",
  "jp": "え～\nそんなのわかんないよ～。",
  "en": ""
 },
 {
  "id": "MAP31/203/00D0",
  "jp": "前世で、隕石にくっついて地球にやってきた微生物、２歳。",
  "en": ""
 },
 {
  "id": "MAP31/203/0116",
  "jp": "そんなの知るか。",
  "en": ""
 },
 {
  "id": "MAP31/203/0136",
  "jp": "私はまだ生まれていませんでしたね。",
  "en": ""
 },
 {
  "id": "MAP31/204/0002",
  "jp": "男湯なので、男子しか入ってはいけません。",
  "en": ""
 },
 {
  "id": "MAP31/204/0048",
  "jp": "だったら入っちゃまずそうだね。",
  "en": ""
 },
 {
  "id": "MAP31/204/0076",
  "jp": "司クン入ってないかなー。",
  "en": ""
 },
 {
  "id": "MAP31/204/009E",
  "jp": "真はまだ子供だから",
  "en": ""
 },
 {
  "id": "MAP31/204/00B8",
  "jp": "イケルっ！！",
  "en": ""
 },
 {
  "id": "MAP31/204/00D4",
  "jp": "興味ないな。",
  "en": ""
 },
 {
  "id": "MAP31/204/00F0",
  "jp": "のぞいてみたい気もしますわ。",
  "en": ""
 },
 {
  "id": "MAP31/205/0002",
  "jp": "　　　　%h　%z「灼熱ノ湯」\n５０℃から７０℃あります。　熱くて入るのにひと苦労。",
  "en": ""
 },
 {
  "id": "MAP31/205/006E",
  "jp": "こんな熱いのヤダよ",
  "en": ""
 },
 {
  "id": "MAP31/205/0090",
  "jp": "こんな熱いの、誰が入るのよ？",
  "en": ""
 },
 {
  "id": "MAP31/205/00BC",
  "jp": "熱いの大好き。",
  "en": ""
 },
 {
  "id": "MAP31/205/00DA",
  "jp": "ふん、入ってやろーじゃねーか。",
  "en": ""
 },
 {
  "id": "MAP31/205/0108",
  "jp": "とても人の入るところじゃないようですね。",
  "en": ""
 },
 {
  "id": "MAP31/206/0002",
  "jp": "　　　　「硫黄ノ湯」\n肌がスベスベになります。\n美容にとても効果があります。",
  "en": ""
 },
 {
  "id": "MAP31/206/006A",
  "jp": "ほんとかなー？",
  "en": ""
 },
 {
  "id": "MAP31/206/0088",
  "jp": "私はすでに、最上の美しさだから、関係ないよ。",
  "en": ""
 },
 {
  "id": "MAP31/206/00C4",
  "jp": "すべすべまんじゅうがにぃ～。",
  "en": ""
 },
 {
  "id": "MAP31/206/00E8",
  "jp": "幅５ｃｍ～６ｃｍ。毒が身体全体にある",
  "en": ""
 },
 {
  "id": "MAP31/206/0114",
  "jp": "表面がすべすべであることからこの名前がつけられた。",
  "en": ""
 },
 {
  "id": "MAP31/206/014E",
  "jp": "岩の割れ目に生息している。",
  "en": ""
 },
 {
  "id": "MAP31/206/0170",
  "jp": "こんなところで蟹の説明するまでもない",
  "en": ""
 },
 {
  "id": "MAP31/206/019C",
  "jp": "ベッコウ\n　　カニダマシ！！（カニよりヤドカリに近い仲間）",
  "en": ""
 },
 {
  "id": "MAP31/206/01E4",
  "jp": "そんなことより強くなりたいゼ！\n強さこそ究極の美！",
  "en": ""
 },
 {
  "id": "MAP31/206/0224",
  "jp": "うれしいですわ。",
  "en": ""
 },
 {
  "id": "MAP31/207/0002",
  "jp": "　　%h　%z「温泉の女神ノ湯」\n効能、温泉の女神の御慈悲により、体が癒されます。",
  "en": ""
 },
 {
  "id": "MAP31/208/001A",
  "jp": "真わかるよ。\nこびーろの言葉。",
  "en": ""
 },
 {
  "id": "MAP31/208/003E",
  "jp": "前にも聞いたでしょ",
  "en": ""
 },
 {
  "id": "MAP31/208/0058",
  "jp": "ＲＰＧモードでは、Ｌ１・Ｒ１ボタンで会話する人を変えられるって。",
  "en": ""
 },
 {
  "id": "MAP31/216/0004",
  "jp": "残念ながら、\n全滅してしまいましたね。",
  "en": ""
 },
 {
  "id": "MAP31/216/0032",
  "jp": "お疲れさまでした。\nリセットボタンを押して下さい",
  "en": ""
 }
