  "en": ""
 },
 {
  "id": "MAP31/186/0168",
  "jp": "いいか真、動物は、いじめちゃいけないんだぞ。",
  "en": ""
 },
 {
  "id": "MAP31/186/01A2",
  "jp": "スミマセン・・・　以後、気をつけます",
  "en": ""
 },
 {
  "id": "MAP31/186/01DA",
  "jp": "いじめているのは、梅林学園の生徒ですわ。",
  "en": ""
 },
 {
  "id": "MAP31/186/0210",
  "jp": "弱い者いぢめなんて許せないっ！！",
  "en": ""
 },
 {
  "id": "MAP31/186/023E",
  "jp": "ちょっとあんた達　やめなさいよ！　　かわいそーでしょ。",
