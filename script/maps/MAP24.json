  "id": "MAP24/215/1456",
  "jp": "・・・・・・？",
  "en": ""
 },
 {
  "id": "MAP24/215/146C",
  "jp": "えっ、\nまさか・・・？",
  "en": ""
 },
 {
  "id": "MAP24/215/14DE",
  "jp": "どうしたの？",
  "en": ""
 },
 {
  "id": "MAP24/215/14FE",
  "jp": "ナージュの様子がおかしいですわ・・・",
  "en": ""
 },
 {
  "id": "MAP24/215/1536",
  "jp": "苦しそうね。\n・・・私も今ので疲れちゃったけど。",
  "en": ""
 },
 {
  "id": "MAP24/215/1578",
  "jp": "なんか、やばいことでもあったのか？",
  "en": ""
 },
 {
  "id": "MAP24/215/15A4",
  "jp": "こんなことが・・・",
  "en": ""
 },
 {
  "id": "MAP24/215/15C8",
  "jp": "ど～したの？\nなーじゅさま？",
  "en": ""
 },
 {
  "id": "MAP24/215/15F4",
  "jp": "よ、よっよっ・・・\nちかよらないで！！",
  "en": ""
 },
 {
  "id": "MAP24/215/1626",
  "jp": "ナンで？",
  "en": ""
 },
 {
  "id": "MAP24/215/1638",
  "jp": "はぁ、はぁ・・・\nあんたって子は・・なんて底無しなの？",
  "en": ""
 },
 {
  "id": "MAP24/215/1674",
  "jp": "真さんの純粋な心を吸い取ろうとしたら吸い取っても、吸い取っても、",
  "en": ""
 },
 {
  "id": "MAP24/215/16BC",
  "jp": "吸い取りきれない！\nそのうちに勝手にエネルギーが入り込んできて・・・",
  "en": ""
 },
 {
  "id": "MAP24/215/1706",
  "jp": "このままでは限界値を超え、\n私、私・・・",
  "en": ""
 },
 {
  "id": "MAP24/215/173E",
  "jp": "すごいエネルギー反応ですね。",
  "en": ""
 },
 {
  "id": "MAP24/215/1768",
  "jp": "どうなるっていうの",
  "en": ""
 },
 {
  "id": "MAP24/215/1788",
  "jp": "いや～な予感・・・",
  "en": ""
 },
 {
  "id": "MAP24/215/17A8",
  "jp": "一体何が、どうしたって言うのよ！？",
  "en": ""
 },
 {
  "id": "MAP24/215/17D8",
  "jp": "・・・やばい雰囲気ですよ。",
  "en": ""
 },
 {
  "id": "MAP24/215/1800",
  "jp": "ナージュがどうかしたのか？",
  "en": ""
 },
 {
  "id": "MAP24/215/1828",
  "jp": "真！\nどうやらお前のせいのようだぞ。",
  "en": ""
 },
 {
  "id": "MAP24/215/1858",
  "jp": "知るもんか！",
  "en": ""
 },
 {
  "id": "MAP24/215/1872",
  "jp": "最後の最後まで、\nお前に引っかきまわされちまったようだな。",
  "en": ""
 },
 {
  "id": "MAP24/215/18B8",
  "jp": "ねえナージュ、\nどうしたのよ！？",
  "en": ""
 },
 {
  "id": "MAP24/215/18E4",
  "jp": "限界値１２００パーセントオーバー！\nもう耐えきれない！！\n放出した以上の・・",
  "en": ""
 },
 {
  "id": "MAP24/215/1936",
  "jp": "パワーを受け入れる事なんて、できないっ。",
  "en": ""
 },
 {
  "id": "MAP24/215/196A",
  "jp": "私・・・\n\n素直に爆発します！",
  "en": ""
 },
 {
  "id": "MAP24/215/1994",
  "jp": "冗談なんか、やめてよ！",
  "en": ""
 },
 {
  "id": "MAP24/215/19B8",
  "jp": "爆発するって！？\n耐えてちょ～だい！",
  "en": ""
 },
 {
  "id": "MAP24/215/19E8",
  "jp": "創造主ならもっとがんばって！",
  "en": ""
 },
 {
  "id": "MAP24/215/1A12",
  "jp": "私たちどうなるの？",
  "en": ""
 },
 {
  "id": "MAP24/215/1A32",
  "jp": "早いとこ、逃げましょう！",
  "en": ""
 },
 {
  "id": "MAP24/215/1A58",
  "jp": "会長、早く！！",
  "en": ""
 },
 {
  "id": "MAP24/215/1A74",
  "jp": "どうする！？\nやばいぞ食い止めろ真！",
  "en": ""
 },
 {
  "id": "MAP24/215/1AA4",
  "jp": "くるならこい！",
  "en": ""
 },
 {
  "id": "MAP24/215/1ABC",
  "jp": "さよ～なら・・・！",
  "en": ""
 },
 {
  "id": "MAP24/216/0004",
  "jp": "残念ながら、\n全滅してしまいましたね。",
  "en": ""
 },
 {
  "id": "MAP24/216/0036",
  "jp": "お疲れさまでした。\nリセットボタンを押して下さい",
  "en": ""
 }
]
