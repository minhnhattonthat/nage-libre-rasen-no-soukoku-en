 },
 {
  "id": "MAP24/215/0C20",
  "jp": "やった～！！",
  "en": ""
 },
 {
  "id": "MAP24/215/0C3A",
  "jp": "苦労が報われたよ。",
  "en": ""
 },
 {
  "id": "MAP24/215/0C5A",
  "jp": "良かったですわ。",
  "en": ""
 },
 {
  "id": "MAP24/215/0C78",
  "jp": "イェ～い！",
  "en": ""
 },
 {
  "id": "MAP24/215/0C90",
  "jp": "それを早く言えよな",
  "en": ""
 },
 {
  "id": "MAP24/215/0CAC",
  "jp": "あの二つの世界の通路を塞ぐ方法は・・たった一つだけ。",
  "en": ""
 },
 {
  "id": "MAP24/215/0CE8",
  "jp": "それには、あなた達の意志の力が必要です。",
  "en": ""
 },
 {
  "id": "MAP24/215/0D1E",
  "jp": "私たちの力？",
  "en": ""
 },
 {
  "id": "MAP24/215/0D34",
  "jp": "そうです。\nあなた達をずっと遠くから見ていて気付きました。",
  "en": ""
 },
 {
  "id": "MAP24/215/0D74",
  "jp": "人間には、底知れぬ力があるという事を",
  "en": ""
 },
 {
  "id": "MAP24/215/0DA0",
  "jp": "その力さえ貸していただければ再び商店街の魔物達を",
  "en": ""
 },
 {
  "id": "MAP24/215/0DD8",
  "jp": "封印する事ができるでしょう。",
  "en": ""
 },
 {
  "id": "MAP24/215/0E02",
  "jp": "本当にそんなこと、\n私たちにできるのですか？\nナージュ。",
  "en": ""
 },
 {
  "id": "MAP24/215/0E46",
  "jp": "あったぼーよ！\nバケモンみたいな黒沢を倒した俺たちだ",
  "en": ""
 },
 {
  "id": "MAP24/215/0E80",
  "jp": "やってやれない事はねーゼ！\n俺たちの力を好きに使ってくれ！",
  "en": ""
 },
 {
  "id": "MAP24/215/0EC6",
  "jp": "わたしの美貌を力にして～！",
  "en": ""
 },
 {
  "id": "MAP24/215/0EEE",
  "jp": "おもしろそ～！",
  "en": ""
 },
 {
  "id": "MAP24/215/0F0A",
  "jp": "わかりました。\n私たちの力で本当に商店街の平和が訪れるなら。",
  "en": ""
 },
 {
  "id": "MAP24/215/0F52",
  "jp": "意見は一致したようね！\nさあナージュ。\n私たち、力になるよ",
  "en": ""
 },
 {
  "id": "MAP24/215/0F9C",
  "jp": "まって！",
  "en": ""
 },
 {
  "id": "MAP24/215/0FBA",
  "jp": "元はといえば全部私のせい。",
  "en": ""
 },
 {
  "id": "MAP24/215/0FE2",
  "jp": "そうとも！",
  "en": ""
 },
 {
  "id": "MAP24/215/0FFA",
  "jp": "杏さんたちに命を救ってもらったお礼がしたいの。\n私の力も使って！",
  "en": ""
 },
 {
  "id": "MAP24/215/1046",
  "jp": "俺たちの力も使ってくれ！",
  "en": ""
 },
 {
  "id": "MAP24/215/106C",
  "jp": "・・・協力するぜ。",
  "en": ""
 },
 {
  "id": "MAP24/215/108C",
  "jp": "ありがとうございます・・・\nみなさん。",
  "en": ""
 },
 {
  "id": "MAP24/215/10BE",
  "jp": "度々すまないな。　恩にきるぜ、大！\n・・いや、みんな。",
  "en": ""
 },
 {
  "id": "MAP24/215/10FC",
  "jp": "感謝します、\nあなた達用意は良いですか？",
  "en": ""
 },
 {
  "id": "MAP24/215/1130",
  "jp": "いいよ！",
  "en": ""
 },
 {
  "id": "MAP24/215/1142",
  "jp": "それでは、私に意識を集中して下さい。",
  "en": ""
 },
 {
  "id": "MAP24/215/1174",
  "jp": "まず、薫さん。\nあなたからは”誇り高き心”を受け取ります。",
  "en": ""
 },
 {
  "id": "MAP24/215/11BA",
  "jp": "はい。",
  "en": ""
 },
 {
  "id": "MAP24/215/11D2",
  "jp": "大さんと迅さん。\nあなた達からは”努力”と”友情”を。",
  "en": ""
 },
 {
  "id": "MAP24/215/1214",
  "jp": "押忍。",
  "en": ""
 },
 {
  "id": "MAP24/215/1230",
  "jp": "了解。",
  "en": ""
 },
 {
  "id": "MAP24/215/1248",
  "jp": "そして、杏さん。\nあなたからは”正義”を。",
  "en": ""
 },
 {
  "id": "MAP24/215/127E",
  "jp": "はい！",
  "en": ""
 },
 {
  "id": "MAP24/215/1296",
  "jp": "次は、澪さん。\nあなたからは”愛”を。",
  "en": ""
 },
 {
  "id": "MAP24/215/12C8",
  "jp": "はい。",
  "en": ""
 },
 {
  "id": "MAP24/215/12E6",
  "jp": "今度は、樹さん。\nあなたからは”情熱”を。",
  "en": ""
 },
 {
  "id": "MAP24/215/131C",
  "jp": "は～い。",
  "en": ""
 },
 {
  "id": "MAP24/215/133C",
  "jp": "そう、忍さん。\nあなたからは”勇気”。",
  "en": ""
 },
 {
  "id": "MAP24/215/136E",
  "jp": "おし！",
  "en": ""
 },
 {
  "id": "MAP24/215/1386",
  "jp": "最後になりましたね、これで、二つの世界の通路を閉ざす力になるでしょう。",
  "en": ""
 },
 {
  "id": "MAP24/215/13D4",
  "jp": "そうです、真さん。\nあなたからは”純粋な心”を受け取りましょう。",
  "en": ""
 },
 {
  "id": "MAP24/215/1420",
  "jp": "あげる～！",
  "en": ""
 },
