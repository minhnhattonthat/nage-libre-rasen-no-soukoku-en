[
 {
  "id": "MAP32/186/0010",
  "jp": "城塞に潜入するなら夜のほうが簡単なんじゃないでしょうか",
  "en": ""
 },
 {
  "id": "MAP32/186/005A",
  "jp": "そうだな昼間よりも警備が薄くなるかもしれない。",
  "en": ""
 },
 {
  "id": "MAP32/186/009C",
  "jp": "夜はちゃんと寝ないと美容に良くないよ",
  "en": ""
 },
 {
  "id": "MAP32/186/00D4",
  "jp": "樹は毎日夜遊びしてるでしょ。",
  "en": ""
 },
 {
  "id": "MAP32/186/0104",
  "jp": "樹ちゃん悪い子ー。",
  "en": ""
 },
 {
  "id": "MAP32/186/012A",
  "jp": "よけいなお世話よ。",
  "en": ""
 },
 {
  "id": "MAP32/187/0010",
  "jp": "みんな、静かにするのよ。",
  "en": ""
 },
 {
  "id": "MAP32/187/003C",
  "jp": "わかってるわよ。　でもこんなときにかぎって真がくしゃみすんのよね。",
  "en": ""
 },
 {
  "id": "MAP32/187/0092",
  "jp": "そんなこと・・・　言われると・・・　ふぁ・ふぁ・・・",
  "en": ""
 },
 {
  "id": "MAP32/187/00DA",
  "jp": "ほら、樹が変なこと言うから、\nこらえろ真！",
  "en": ""
 },
 {
  "id": "MAP32/187/0110",
  "jp": "くしゅん",
  "en": ""
 },
 {
  "id": "MAP32/187/012C",
  "jp": "なんで澪がくしゃみすんだよー！？",
  "en": ""
 },
 {
  "id": "MAP32/187/0160",
  "jp": "しっ忍さん\n声が大きい！",
  "en": ""
 },
 {
  "id": "MAP32/187/0188",
  "jp": "おーほっほっほ、　そんな所に隠れていても無駄よ。",
  "en": ""
 },
 {
  "id": "MAP32/187/01C0",
  "jp": "暗くても、わかってるんだから。",
  "en": ""
 },
 {
  "id": "MAP32/187/01E6",
  "jp": "今度こそ、その息の根を止めてあげるわやーっておしまいっ",
  "en": ""
 },
 {
  "id": "MAP32/188/0006",
  "jp": "　９面スタート　",
  "en": ""
 },
 {
  "id": "MAP32/188/0020",
  "jp": "クリアー条件　　\n  %c02　神崎　薫　を倒せ",
  "en": ""
 },
 {
  "id": "MAP32/189/0036",
  "jp": "これで外の警備は　全員倒せたようですね。",
  "en": ""
 },
 {
  "id": "MAP32/189/0070",
  "jp": "いよいよ城塞に突入ね。",
  "en": ""
 },
 {
  "id": "MAP32/189/00F0",
  "jp": "夜なら警備も薄いと思ってたのに・・・",
  "en": ""
 },
 {
  "id": "MAP32/189/012A",
  "jp": "結局こうなっちゃうんだもんな。",
  "en": ""
 },
 {
  "id": "MAP32/189/015E",
  "jp": "でも、まだ戦闘体制が、整っているとは思えませんわ。",
  "en": ""
 },
 {
  "id": "MAP32/189/01A6",
  "jp": "そうだな。",
  "en": ""
 },
 {
  "id": "MAP32/189/01C6",
  "jp": "とにかく、早くナージュ像を探さなきゃ",
  "en": ""
 },
 {
  "id": "MAP32/189/0200",
  "jp": "どうして？",
  "en": ""
 },
 {
  "id": "MAP32/189/0220",
  "jp": "異世界に来て、真もとうとうどうにかなっちまったようだな",
  "en": ""
 },
 {
  "id": "MAP32/190/0016",
  "jp": "私もうダメ・・・　もう動けない。",
  "en": ""
 },
 {
  "id": "MAP32/190/0046",
  "jp": "超疲れた、今回はパス。",
  "en": ""
 },
 {
  "id": "MAP32/190/006C",
  "jp": "えーん、みんなが　いぢめるよー。",
  "en": ""
 },
 {
  "id": "MAP32/190/009C",
  "jp": "チッ、オレとしたことが・・・不覚。",
  "en": ""
 },
 {
  "id": "MAP32/190/00CE",
  "jp": "ここで負けるなんてくやしいですわ。",
  "en": ""
 },
 {
  "id": "MAP32/191/000C",
  "jp": "ちょっとぉ。\nここは私たちのお城よ。",
  "en": ""
 },
 {
  "id": "MAP32/191/0036",
  "jp": "関係無いひとは、　入って来ないで。",
  "en": ""
 },
 {
  "id": "MAP32/191/006E",
  "jp": "ここから先は、　　関係者以外立入禁止よ。",
  "en": ""
 },
 {
  "id": "MAP32/192/000C",
  "jp": "こんな所まで押しかけるなんて、ホントしつこいわね。",
  "en": ""
 },
 {
  "id": "MAP32/193/000C",
  "jp": "あなたたち・・・　ナージュ像のことはあきらめなさい。",
  "en": ""
 },
 {
  "id": "MAP32/193/0056",
  "jp": "あきらめろって、　言ってるでしょっ。",
  "en": ""
 },
 {
  "id": "MAP32/194/000C",
  "jp": "まだあきらめていないのか。\n大ケガしないうちに帰るんだ。",
  "en": ""
 },
 {
  "id": "MAP32/194/006A",
  "jp": "この俺とやる気か？",
  "en": ""
 },
 {
  "id": "MAP32/194/008A",
  "jp": "ったりめーだっ！！",
  "en": ""
 },
 {
  "id": "MAP32/194/00AC",
  "jp": "おとなしく帰れっ！",
  "en": ""
 },
 {
  "id": "MAP32/194/00CC",
  "jp": "イヤですっ！！",
  "en": ""
 },
 {
  "id": "MAP32/195/000C",
  "jp": "とっととお家へ帰んな！！",
  "en": ""
 },
 {
  "id": "MAP32/195/005C",
  "jp": "二度と動けねーようにしてやる。",
  "en": ""
 },
 {
  "id": "MAP32/195/0088",
  "jp": "こっちのセリフだ。",
  "en": ""
 },
 {
  "id": "MAP32/195/00AA",
  "jp": "はみがきも忘れんな",
  "en": ""
 },
 {
  "id": "MAP32/195/00CA",
  "jp": "は～～い。",
  "en": ""
 },
 {
  "id": "MAP32/196/0022",
  "jp": "”水色のジャケット”\n　を手に入れた\n（着せかえ用アイテム）",
  "en": ""
 },
 {
  "id": "MAP32/196/0066",
  "jp": "宝箱は空っぽだ。",
  "en": ""
 },
 {
  "id": "MAP32/197/0022",
  "jp": "”一年生の体操服”\n　を手に入れた\n（着せかえ用アイテム）",
  "en": ""
 },
 {
  "id": "MAP32/197/0064",
  "jp": "宝箱は空っぽだ。",
  "en": ""
 },
 {
  "id": "MAP32/198/0006",
  "jp": "きーっ。\n司令室のナージュ像を護るのよーっ！！",
  "en": ""
 },
 {
  "id": "MAP32/198/003A",
  "jp": "増援部隊っ！！\n後はまかせたわよっ",
  "en": ""
 },
 {
  "id": "MAP32/198/00C4",
  "jp": "クリアー条件変更\n  %c02　敵を全滅させろ",
  "en": ""
 },
 {
  "id": "MAP32/199/0006",
  "jp": "くっ・・・\n腕を上げたな。",
  "en": ""
 },
 {
  "id": "MAP32/200/0006",
  "jp": "次はこうはいかんぞ",
  "en": ""
 },
 {
  "id": "MAP32/201/000C",
  "jp": "何で早番の私たちがこんな時間に戦わなきゃいけないの？",
  "en": ""
 },
 {
  "id": "MAP32/202/000C",
  "jp": "せっかくいい夢見てたのに・・・\nこんな時間に迷惑でしょ。",
  "en": ""
 },
 {
  "id": "MAP32/203/0012",
  "jp": "あんまり顔見ないで化粧するヒマ無かったんだから。",
  "en": ""
 },
 {
  "id": "MAP32/203/0060",
  "jp": "別に見たくないよ。",
  "en": ""
 },
 {
  "id": "MAP32/203/0082",
  "jp": "そーみたいね。\nキヒヒ",
  "en": ""
 },
 {
  "id": "MAP32/203/00A6",
  "jp": "キャー\nおばけー。",
  "en": ""
 },
 {
  "id": "MAP32/203/00C6",
  "jp": "女は顔じゃねーんだよ！",
  "en": ""
 },
 {
  "id": "MAP32/203/00EC",
  "jp": "ハ、ハイ。",
  "en": ""
 },
 {
  "id": "MAP32/204/000E",
  "jp": "”ジーパン”を手に入れた\n（着せかえ用アイテム）",
  "en": ""
 },
 {
  "id": "MAP32/205/000E",
  "jp": "”ジャンパースカート”\n　を手に入れた\n（着せかえ用アイテム）",
  "en": ""
 },
 {
  "id": "MAP32/206/000C",
  "jp": "魔導書を手に入れた",
  "en": ""
 },
 {
  "id": "MAP32/206/0026",
  "jp": "サモンホイホイの魔法\nを使えるようになった",
  "en": ""
 },
 {
  "id": "MAP32/213/0006",
  "jp": "私が、この城塞を設計した建築技師。\n防犯設備もばっちりよ。",
  "en": ""
 },
 {
  "id": "MAP32/213/0046",
  "jp": "あなた達は、入れないんだから！！",
  "en": ""
 },
 {
  "id": "MAP32/216/0004",
  "jp": "残念ながら、\n全滅してしまいましたね。",
  "en": ""
 },
 {
  "id": "MAP32/216/0032",
  "jp": "お疲れさまでした。\nリセットボタンを押して下さい",
  "en": ""
 }
