  "id": "MAP01R/203/0324",
  "jp": "ぶひ、ぶひぶひぃ。（よってたかって　いじめるなよ～）",
  "en": "Oink, oink-oink. (Don't gang up on me~)"
 },
 {
  "id": "MAP01R/203/0360",
