[
 {
  "id": "MAP50/186/0028",
  "jp": "ナージュ像は向こうの塔にあるんじゃない？",
  "en": ""
 },
 {
  "id": "MAP50/186/005E",
  "jp": "この橋を渡らないと向こうの塔へは行けないみたいだよ。",
  "en": ""
 },
 {
  "id": "MAP50/186/00A0",
  "jp": "こんな橋の上で敵に襲われたら逃げ場がありませんわ。",
  "en": ""
 },
 {
  "id": "MAP50/186/00E0",
  "jp": "それが敵のねらいかもな。",
  "en": ""
 },
 {
  "id": "MAP50/186/0106",
  "jp": "どうせ行くなら早く行こーよ。",
  "en": ""
