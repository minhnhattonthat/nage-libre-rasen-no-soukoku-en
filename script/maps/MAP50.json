  "en": ""
 },
 {
  "id": "MAP50/187/001C",
  "jp": "　クリアー条件　　\n  %c02　橋を渡りきれ　",
  "en": ""
 },
 {
  "id": "MAP50/188/0038",
  "jp": "なんなのよ？\nこの橋ぃ。",
  "en": ""
 },
 {
  "id": "MAP50/188/0062",
  "jp": "こんな罠があるなんて。",
  "en": ""
 },
 {
  "id": "MAP50/188/008C",
  "jp": "ただ単に、古かっただけだったりして。",
  "en": ""
 },
 {
  "id": "MAP50/188/00C4",
  "jp": "でも、罠だとしたら",
  "en": ""
 },
 {
  "id": "MAP50/188/00DE",
  "jp": "そうまでして守りたい物が塔にあるってことですね。",
  "en": ""
 },
 {
  "id": "MAP50/188/0122",
  "jp": "守りたい物って？",
