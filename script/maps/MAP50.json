 },
 {
  "id": "MAP50/214/0006",
  "jp": "腹へったブー。\n（どうした、かかってこい！）",
  "en": ""
 },
 {
  "id": "MAP50/215/0006",
  "jp": "黒沢様の邪魔するやつは、ゆるさねーど",
  "en": ""
 },
 {
  "id": "MAP50/215/0032",
  "jp": "うまい飯食わしてくれる人いなくなっちまうど！",
  "en": ""
 },
 {
  "id": "MAP50/215/007E",
  "jp": "あなたねー、この世界まで黒沢に脅かされるって時に、",
  "en": ""
 },
 {
  "id": "MAP50/215/00B8",
  "jp": "何をのんきな事言ってんの！",
  "en": ""
 },
 {
  "id": "MAP50/215/00E0",
  "jp": "この世界の事なんか関係ねーど！",
  "en": ""
 },
 {
  "id": "MAP50/215/0106",
  "jp": "おれたちは、うまい飯さえ食えりゃーいいんだど！",
  "en": ""
 },
 {
  "id": "MAP50/215/0144",
  "jp": "やめなさいよ！",
  "en": ""
 },
 {
  "id": "MAP50/215/015A",
  "jp": "黒沢はあなた達の事を、まるでブタのように扱うつもりよ！",
  "en": ""
 },
 {
  "id": "MAP50/215/019E",
  "jp": "なんだと！！",
  "en": ""
 },
 {
  "id": "MAP50/215/01B2",
  "jp": "おれはブタなんかじゃねーど！ブヒッ",
  "en": ""
 },
 {
  "id": "MAP50/215/01E4",
  "jp": "ブタさん、そこ通して。ごはんならあとで真が作ってあげるから。",
  "en": ""
 },
 {
  "id": "MAP50/215/0228",
  "jp": "トンカツとか。",
  "en": ""
 },
 {
  "id": "MAP50/215/0244",
  "jp": "おれは、共食いなんかしねーど！！\n・・・いや、",
  "en": ""
 },
 {
  "id": "MAP50/215/0278",
  "jp": "馬鹿にするな！おれはブタなんかじゃねーど！ブヒッ！！",
  "en": ""
 },
 {
  "id": "MAP50/215/02BC",
  "jp": "おい、赤ブタ！",
  "en": ""
 },
 {
  "id": "MAP50/215/02D2",
  "jp": "そこをどかねえなら焼きブタにしてやるぞ！",
  "en": ""
 },
 {
  "id": "MAP50/215/0308",
  "jp": "お前たちを食い止めろとの黒沢様の命令だど。",
  "en": ""
 },
 {
  "id": "MAP50/215/033A",
  "jp": "食うか、食われてたまるかだど！ブヒッ",
  "en": ""
 },
 {
  "id": "MAP50/215/036E",
  "jp": "ブタさん、わかって・・・今、平和のために私たちがするべき事は、",
  "en": ""
 },
 {
  "id": "MAP50/215/03B4",
  "jp": "黒沢さんからナージュ像を取り返す事よ",
  "en": ""
 },
 {
  "id": "MAP50/215/03E6",
  "jp": "そんな事知るかだど",
  "en": ""
 },
 {
  "id": "MAP50/215/0400",
  "jp": "おれたちは、あした食う飯にも苦労してんだど！",
  "en": ""
 },
 {
  "id": "MAP50/216/0004",
  "jp": "残念ながら、\n全滅してしまいましたね。",
  "en": ""
 },
 {
