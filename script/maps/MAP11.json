[
 {
  "id": "MAP11/186/003A",
  "jp": "な～んだ、\nどの階段昇っても、似たようなトコに出るんじゃん。",
  "en": ""
 },
 {
  "id": "MAP11/186/0082",
  "jp": "悩んでそんしちゃった。",
  "en": ""
 },
 {
  "id": "MAP11/186/00A6",
  "jp": "ソンソン。",
  "en": ""
 },
 {
  "id": "MAP11/186/00BE",
  "jp": "そんなこと言ってるヒマはねぇぞ。",
  "en": ""
 },
 {
  "id": "MAP11/186/00EC",
  "jp": "また、神崎さんに、逃げられてしまいますわ。",
  "en": ""
 },
 {
