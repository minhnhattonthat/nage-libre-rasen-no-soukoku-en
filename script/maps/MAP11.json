  "en": ""
 },
 {
  "id": "MAP11/213/0006",
  "jp": "神崎様って、私達下っ端にきつくあたるの。ぐすん。",
  "en": ""
 },
 {
  "id": "MAP11/213/0054",
  "jp": "神崎様を悪く言うやつは、ゆるせないっ覚悟おし！",
  "en": ""
 },
 {
  "id": "MAP11/213/0092",
  "jp": "そうよ、神崎はひどいやつよ！",
  "en": ""
 },
 {
  "id": "MAP11/213/00BE",
  "jp": "私も超～ヤな感じ！",
  "en": ""
 },
 {
  "id": "MAP11/213/00E0",
  "jp": "実は、あのひと、いい人だよ。",
  "en": ""
 },
 {
  "id": "MAP11/213/010A",
  "jp": "なんですって！私、あなたの事理解できない！",
  "en": ""
 },
 {
  "id": "MAP11/213/0142",
  "jp": "・・・心まで・・・",
  "en": ""
 },
 {
  "id": "MAP11/213/015C",
  "jp": "下僕？",
  "en": ""
 },
 {
  "id": "MAP11/213/0172",
  "jp": "俺もあいつは、ゆるせない！",
  "en": ""
 },
 {
  "id": "MAP11/213/019C",
  "jp": "あの方の仲間でいるのは、やめた方が良いと思いますわ。",
  "en": ""
 },
 {
  "id": "MAP11/216/0004",
