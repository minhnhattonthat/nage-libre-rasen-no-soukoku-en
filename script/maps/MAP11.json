  "en": ""
 },
 {
  "id": "MAP11/193/0266",
  "jp": "まてぇーっ！",
  "en": ""
 },
 {
  "id": "MAP11/194/000C",
  "jp": "ここまで上がって来るとは、なかなかやるな。",
  "en": ""
 },
 {
  "id": "MAP11/195/0012",
  "jp": "あれ、こんなトコまで来ちゃったの？　下の人たちなにやってんのよ！？",
  "en": ""
 },
 {
  "id": "MAP11/195/0072",
  "jp": "もう　みんな、\n逃げちゃったんじゃない。",
  "en": ""
 },
