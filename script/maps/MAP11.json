  "en": ""
 },
 {
  "id": "MAP11/196/0012",
  "jp": "これは大事な鏡なんだ。\n近寄るな！！",
  "en": ""
 },
 {
  "id": "MAP11/196/003C",
  "jp": "なんにも怪しいことなんてないから。",
  "en": ""
 },
 {
  "id": "MAP11/196/006E",
  "jp": "近寄るなっつーのっ",
  "en": ""
 },
 {
  "id": "MAP11/197/0016",
  "jp": "私もうダメ・・・　もう動けない。",
  "en": ""
 },
 {
  "id": "MAP11/197/0046",
  "jp": "超疲れた、今回はパス。",
  "en": ""
 },
 {
  "id": "MAP11/197/006C",
  "jp": "えーん、みんなが　いぢめるよー。",
  "en": ""
 },
 {
  "id": "MAP11/197/009C",
  "jp": "チッ、オレとしたことが・・・不覚。",
  "en": ""
 },
 {
  "id": "MAP11/197/00CE",
  "jp": "ここで負けるなんてくやしいですわ。",
  "en": ""
 },
