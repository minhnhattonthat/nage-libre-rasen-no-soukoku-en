 {
  "id": "MAP11/207/0028",
  "jp": "この鏡・・・\nなんかヘンだな～。鏡の向こうに、人の気配が・・・",
  "en": ""
 },
 {
  "id": "MAP11/207/007A",
  "jp": "この鏡・・・\nおかしんじゃない？私、こんなにたれ目じゃないよー。",
  "en": ""
 },
 {
  "id": "MAP11/207/00CE",
  "jp": "鏡の中の、ピンクの髪のヘンな人がこっち見てるー。",
