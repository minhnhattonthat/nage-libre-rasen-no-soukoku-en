  "jp": "１１面スタート　",
  "en": ""
 },
 {
  "id": "MAP11/187/0020",
  "jp": "　クリアー条件　　\n  %c02　神崎　薫　を倒せ　",
  "en": ""
 },
 {
  "id": "MAP11/188/001C",
  "jp": "ロックされてるの？",
  "en": ""
 },
 {
  "id": "MAP11/188/003E",
  "jp": "何でー？\n鍵でもかかってんの",
  "en": ""
 },
 {
  "id": "MAP11/188/0068",
  "jp": "ひらけー・・・・・",
  "en": ""
 },
 {
  "id": "MAP11/188/0082",
  "jp": "ゴマッ！！",
  "en": ""
 },
 {
  "id": "MAP11/188/0094",
  "jp": "（チッ、だめか。）",
  "en": ""
 },
 {
  "id": "MAP11/188/00B6",
  "jp": "開かねえ。\nロックされてんのか",
  "en": ""
 },
 {
  "id": "MAP11/188/00E2",
  "jp": "鍵がなければ開かないようですね。",
  "en": ""
 },
 {
  "id": "MAP11/188/011E",
  "jp": "ロックを解除した",
  "en": ""
 },
 {
  "id": "MAP11/189/0006",
  "jp": "こんなに強いなんて",
  "en": ""
 },
 {
  "id": "MAP11/189/0020",
  "jp": "もうダメ・・・\n逃げちゃおっと。",
  "en": ""
 },
 {
  "id": "MAP11/190/000C",
  "jp": "やばっ！！\n鍵落としちゃった。",
  "en": ""
 },
 {
  "id": "MAP11/190/0032",
  "jp": "鍵が落ちている。",
  "en": ""
 },
 {
  "id": "MAP11/190/004E",
  "jp": "鍵をひろった。",
  "en": ""
 },
 {
  "id": "MAP11/190/0080",
  "jp": "きっと、これで扉が開くんだ。",
  "en": ""
 },
 {
  "id": "MAP11/190/00AC",
  "jp": "やった！\nこれさえあれば、　扉が開く。",
  "en": ""
 },
 {
  "id": "MAP11/190/00E0",
  "jp": "これで扉の鍵が開くのかな。",
  "en": ""
 },
 {
  "id": "MAP11/190/010A",
  "jp": "これさえあれば、　扉が開く・・のか？",
  "en": ""
 },
 {
  "id": "MAP11/190/013E",
  "jp": "この鍵で扉が開けばいいんですけど・・",
  "en": ""
 },
 {
  "id": "MAP11/191/0016",
  "jp": "ちょっ・・・、　　勝手に入って来ないでよっ！！",
  "en": ""
 },
 {
  "id": "MAP11/191/0054",
  "jp": "大っ！　迅っ！\n早くきなさいっ！",
  "en": ""
 },
 {
  "id": "MAP11/192/000A",
  "jp": "今度こそ勝つっ！！",
  "en": ""
 },
 {
  "id": "MAP11/193/006A",
  "jp": "ハァ　ハァ\nこ、今回はこれくらいで許してあげる。",
  "en": ""
 },
 {
  "id": "MAP11/193/00AE",
