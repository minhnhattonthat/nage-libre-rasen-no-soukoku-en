[
 {
  "id": "MAP23/186/0028",
  "jp": "ナージュ像を返せ！",
  "en": ""
 },
 {
  "id": "MAP23/186/0048",
  "jp": "見てっ、ナージュ像が、あんなに大きくなっちゃった。",
  "en": ""
 },
 {
  "id": "MAP23/186/0094",
  "jp": "ちがうっ。\nあれは、私達が探していたナージュ像じゃないよっ。",
  "en": ""
 },
 {
  "id": "MAP23/186/00DC",
  "jp": "きっと・・・\nあれがナージュ像のオリジナルで、",
  "en": ""
 },
 {
  "id": "MAP23/186/0110",
  "jp": "南寿町にあった、　ナージュ像は、そのレプリカなんですわ",
  "en": ""
 },
 {
  "id": "MAP23/186/0154",
  "jp": "おそらく、オレ達の探していたナージュ像は、",
  "en": ""
 },
 {
  "id": "MAP23/186/0186",
  "jp": "ナージュの力を開放するための、キーだったんだ。",
  "en": ""
 },
 {
  "id": "MAP23/186/01C2",
  "jp": "それより見てよっ。テーブルの上に神崎がっ・・・",
  "en": ""
 },
 {
  "id": "MAP23/186/0208",
  "jp": "ごちそーだー。",
  "en": ""
 },
 {
  "id": "MAP23/186/022E",
  "jp": "すかたんっ！",
  "en": ""
 },
 {
  "id": "MAP23/186/0242",
  "jp": "神崎を生け贄にしてその生命力を自分の魔力に換えるつもりなんだっ！",
  "en": ""
 },
 {
  "id": "MAP23/186/0296",
  "jp": "ちぃっ、\nお前達、なぜ私の　邪魔をする？",
  "en": ""
 },
 {
  "id": "MAP23/186/02CE",
  "jp": "人の命をなんだと思ってるの？",
  "en": ""
 },
 {
  "id": "MAP23/186/02FC",
  "jp": "ふん、全ての人間は私の魔力となり、",
  "en": ""
 },
 {
  "id": "MAP23/186/0326",
  "jp": "私と共に理想を達成することを望んでいるのだ。",
  "en": ""
 },
 {
  "id": "MAP23/186/0364",
  "jp": "なんて自分勝手な。",
  "en": ""
 },
 {
  "id": "MAP23/186/0384",
  "jp": "真みたーい。",
  "en": ""
 },
 {
  "id": "MAP23/186/039E",
  "jp": "ナージュ像が盗まれて、現実世界の人達は迷惑してんのよ！",
  "en": ""
 },
 {
  "id": "MAP23/186/03E2",
  "jp": "現実世界？\nふっ、お前達が、　現実と思い込んでいる世界は",
  "en": ""
 },
 {
  "id": "MAP23/186/0420",
  "jp": "創造神ナージュによって創られたテストケースの１つにすぎんのだ。",
  "en": ""
 },
 {
  "id": "MAP23/186/0472",
  "jp": "もっとも、この世界もそうだがな・・・",
  "en": ""
 },
 {
  "id": "MAP23/186/049E",
  "jp": "だが、今からこの世界が、真の現実世界となる・・・",
  "en": ""
 },
 {
  "id": "MAP23/186/04EE",
  "jp": "・・・お前ら、\nちゃんと聞く気、　あんのか？",
  "en": ""
 },
 {
  "id": "MAP23/186/0530",
  "jp": "樹も真もっ、\nなに寝てんのよっ！",
  "en": ""
 },
 {
  "id": "MAP23/186/057C",
  "jp": "え？・・・\nもう終わったの？",
  "en": ""
 },
 {
  "id": "MAP23/186/05AA",
  "jp": "・・・・真、居眠りなんてしてないよ。",
  "en": ""
 },
 {
  "id": "MAP23/186/05E2",
  "jp": "・・・・・・・・・",
  "en": ""
 },
 {
  "id": "MAP23/186/05FC",
  "jp": "ナージュの魔力によって、お前達の言う現実世界の下等な者共を支配するのだ。",
  "en": ""
 },
 {
  "id": "MAP23/186/064C",
  "jp": "しょせん親や学校、マスコミのいいなりで、自分の意志を持たぬ奴等だ、",
  "en": ""
 },
 {
  "id": "MAP23/186/0696",
  "jp": "私の奴隷になったほうが有意義だろう。",
  "en": ""
 },
 {
  "id": "MAP23/186/06C8",
  "jp": "キミせりふ長いよ。",
  "en": ""
 },
 {
  "id": "MAP23/186/06E8",
  "jp": "この世界の文明は、高度に進化しすぎた魔法をもてあまして滅んだはずですわ。",
  "en": ""
 },
 {
  "id": "MAP23/186/0738",
  "jp": "そんな危険な物を、扱えると思っているんですか！？",
  "en": ""
 },
