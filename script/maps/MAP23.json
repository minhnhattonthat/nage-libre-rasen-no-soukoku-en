  "id": "MAP23/187/004A",
  "jp": "・・・何ともない。",
  "en": ""
 },
 {
  "id": "MAP23/187/006A",
  "jp": "・・・あれ？\n魔法・・・効いてないの？",
  "en": ""
 },
 {
  "id": "MAP23/187/009C",
  "jp": "彼の魔法が効くのは自分の意志を持たない人だけなんですわ",
  "en": ""
 },
 {
  "id": "MAP23/187/00E0",
  "jp": "「心に闇を持つ者、ナージュに心を奪われる」",
  "en": ""
 },
