  "id": "MAP23/186/0776",
  "jp": "もういい、時間の無駄だ。",
  "en": ""
 },
 {
  "id": "MAP23/186/0796",
  "jp": "貴様らも、この魔法で私の奴隷となるがいい！！",
  "en": ""
 },
 {
  "id": "MAP23/187/0002",
  "jp": "　・　・　・　・　・　・　・",
  "en": ""
 },
